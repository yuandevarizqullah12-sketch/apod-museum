{
  "images": {
    "sizes": [256, 640, 1080, 1920],
    "qualities": [75],
    "formats": ["image/webp"],
    "minimumCacheTTL": 604800,
    "remotePatterns": [
      { "protocol": "https", "hostname": "apod.nasa.gov" },
      { "protocol": "https", "hostname": "science.nasa.gov" },
      { "protocol": "https", "hostname": "assets.science.nasa.gov" }
    ]
  },
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/(css|js|data)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] }
  ]
}
